{
  "framework": null,
  "buildCommand": "node tools/build-tournaments.js",
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tft-esports.com"
        }
      ],
      "destination": "https://www.tft-esports.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tft-esport.vercel.app"
        }
      ],
      "destination": "https://www.tft-esports.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tft-esports.com"
        }
      ],
      "destination": "https://www.tft-esports.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tft-esport.vercel.app"
        }
      ],
      "destination": "https://www.tft-esports.com/:path*",
      "permanent": true
    },
    {
      "source": "/cups",
      "destination": "/tft-tournaments",
      "permanent": true
    },
    {
      "source": "/cups/turnier",
      "destination": "/tft-tournaments",
      "permanent": true
    },
    {
      "source": "/ueber-uns",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "/legal-notice",
      "permanent": true
    },
    {
      "source": "/datenschutz",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/twitch/live-streams",
      "destination": "/twitch",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
